# ==================== Python 产物 ====================
# Python 编译缓存目录（每次修改代码自动生成，无需版本控制）
__pycache__/
# Python 字节码文件
*.py[cod]
# PyPy 编译缓存
*$py.class
# Python 包构建目录
*.egg-info/
dist/
build/
eggs/
# 旧版 Python 包格式
*.egg

# ==================== 虚拟环境 ====================
# 虚拟环境目录（包含第三方包，其他人可以 pip install 重新安装）
.venv/
venv/
ENV/
env/

# ==================== 环境变量（绝对不要提交真实密钥！）====================
# 环境变量文件（包含 API Key、数据库密码等敏感信息）
.env
.env.local
.env.*.local

# ==================== IDE 配置 ====================
# VS Code 配置（包含你的个性化设置，可能含路径信息）
.vscode/
# PyCharm 配置（包含项目路径、解释器配置等）
.idea/
# Vim 交换文件
*.swp
*.swo
# Vim 备份文件
*~

# ==================== 操作系统文件 ====================
# macOS 自动生成的文件
.DS_Store
# Windows 缩略图缓存
Thumbs.db
# Windows 缩略图缓存（旧版）
ehthumbs.db
# Windows 文件夹配置
Desktop.ini

# ==================== 数据库文件 ====================
# SQLite 数据库文件（可能包含真实用户数据）
*.db
*.sqlite3
*.sqlite
# SQLAlchemy 生成的数据库文件
*.db-journal

# ==================== Jupyter Notebook ====================
.ipynb_checkpoints/

# ==================== 日志文件 ====================
# 应用运行日志（可能包含敏感请求数据）
*.log
logs/
*.log.*

# ==================== 测试覆盖率 ====================
.coverage
htmlcov/
.pytest_cache/
.coverage.*
coverage.xml

# ==================== FAISS 向量索引 ====================
# 向量数据库索引文件（体积通常很大，且他人需自行生成）
faiss_index/
faiss_index.*

# ==================== 临时文件 ====================
*.tmp
*.temp
*.cache

# ==================== 文档产物 ====================
# 如果你用 Sphinx 或其他工具生成文档
docs/_build/

# ==================== 上传的媒体文件 ====================
# 如果你上传了演示截图或视频到仓库
media/
uploads/